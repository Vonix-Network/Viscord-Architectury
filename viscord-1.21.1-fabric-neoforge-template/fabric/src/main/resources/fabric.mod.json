{
  "schemaVersion": 1,
  "id": "viscord",
  "version": "${version}",
  "name": "Viscord",
  "description": "Server-side bidirectional chat integration for Discord and Fluxer.",
  "authors": [
    "Vonix Network"
  ],
  "contact": {
    "homepage": "https://github.com/Vonix-Network/Viscord-Architectury",
    "sources": "https://github.com/Vonix-Network/Viscord-Architectury"
  },
  "license": "MIT",
  "icon": "assets/viscord/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "network.vonix.viscord.fabric.ViscordFabric"
    ]
  },
  "mixins": [
    "viscord.mixins.json",
    "viscord-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  }
}
